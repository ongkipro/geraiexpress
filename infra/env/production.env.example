# T-062 / DEC-020: production environment TEMPLATE (names and public values only; committed, no secrets).
# Copy to a file OUTSIDE the checkout, for example /etc/geraiexpress/production.env, `chmod 600` it, fill the
# secrets, and start Compose with it (RELEASE.md):
#   GX_ENV_FILE=/etc/geraiexpress/production.env docker compose --env-file /etc/geraiexpress/production.env --profile prod up -d
# `pnpm check:environments production=<that file> staging=<the staging file>` is a release gate.
# Secret variables are listed with NO value here; the checker refuses a committed template that has one.

# --- Compose / proxy (not seen by the app) ---
ACME_EMAIL=ops@example.invalid
SITE_HOST=geraiexpress.com
APP_HOST=app.geraiexpress.com
OWNER_HOST=owner.geraiexpress.com
HOOKS_HOST=hooks.geraiexpress.com

# --- Data: PostgREST and the database (ADR-0002); this environment's OWN, never shared with the other ---
# The compose postgrest service (compose.yaml) is the default target; set POSTGREST_URL only to use another one.
POSTGREST_URL=http://postgrest:3000
# Where the database runs is the owner's decision: an external PostgreSQL, or the optional `postgres` service
# of compose.yaml (--profile db). Read by Compose for the postgrest container (and, with the `db` profile,
# POSTGRES_PASSWORD for the postgres container); the app does not use them. Secrets.
PGRST_DB_URI=
POSTGRES_PASSWORD=

# --- Hosts: absolute origins the app builds links from (never from request headers) ---
SITE_ORIGIN=https://geraiexpress.com
APP_ORIGIN=https://app.geraiexpress.com
OWNER_ORIGIN=https://owner.geraiexpress.com
HOOKS_ORIGIN=https://hooks.geraiexpress.com

# --- Mengantar ---
MENGANTAR_ENV=production
PARTNER_ID=ongkirich
# Secret: Partner Secret (owner-held).
MENGANTAR_PARTNER_SECRET=
PARTNER_TERMS_VERSION=
PARTNER_PRIVACY_VERSION=
PARTNER_TERMS_URL=
PARTNER_PRIVACY_URL=

# --- Credential sealing (SEC-7): one ring per environment. Secrets. ---
CREDENTIAL_KEYS=
CREDENTIAL_KEY_CURRENT=
# Legacy single key (version 1) while the ring above is unset.
CREDENTIAL_KEY=

# --- Auth (application-owned, ADR-0002) ---
# Secret: signs the access tokens PostgREST verifies and the machine identity (DEC-010). At least 32 characters.
AUTH_JWT_SECRET=
# Secret: roots the one-time-code and TOTP sealing keys. At least 32 characters, different from AUTH_JWT_SECRET.
AUTH_SECRET=
# Secret: independent HMAC root for public tracking links. Generate 32+ random bytes; no default.
TRACKING_TOKEN_SECRET=
# Cloudflare Turnstile widget: the public site key and its secret (verified server-side). Required: the server
# refuses to start the auth module without TURNSTILE_SECRET_KEY (AUTH_CAPTCHA_DISABLED=true is local only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Public hosts serving the widget (comma-separated); a token solved on any other host is refused. Never localhost.
TURNSTILE_HOSTNAMES=app.geraiexpress.com,owner.geraiexpress.com
# Code mail (T-063, domain geraiexpress.com). Leave MAIL_TRANSPORT unset until the provider account exists and the
# domain's SPF/DKIM/DMARC records are published: mail then fails closed. To enable: MAIL_TRANSPORT=smtp and the
# provider's SMTP submission values below (TLS mandatory: tls for port 465, starttls for port 587).
MAIL_TRANSPORT=
MAIL_FROM=no-reply@geraiexpress.com
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
# Secret: the provider's SMTP password or API key. Never committed; differs per environment.
SMTP_PASSWORD=

# --- Scheduler (the scheduler container and /api/internal/cron/*). Secret. ---
CRON_SECRET=
