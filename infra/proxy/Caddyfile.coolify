# Coolify terminates public TLS. Only its verified peer may supply the visitor address.
# Path: visitor -> Cloudflare -> Coolify edge (Traefik) -> this gateway -> app. Traefik replaces X-Forwarded-For with
# its own peer (a Cloudflare edge address, observed on the live host 2026-11-10), so the visitor address survives only
# in CF-Connecting-IP, which Cloudflare overwrites on every request. Trusting it is safe only because the host firewall
# admits 80/443 from Cloudflare's published ranges alone (RELEASE.md, Vultr+Coolify gate 2): re-check that firewall
# before changing this. A request from any other peer keeps its TCP address.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static {$COOLIFY_PROXY_CIDR}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

:8080 {
	@hosts host {$SITE_HOST:geraiexpress.com} {$APP_HOST:app.geraiexpress.com} {$OWNER_HOST:owner.geraiexpress.com} {$HOOKS_HOST:hooks.geraiexpress.com}
	@internal path_regexp (?i)^/+api/+internal(/|$)
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	handle @internal {
		respond "Not Found" 404
	}
	handle @hosts {
		reverse_proxy app:3000 {
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up -X-Client-IP
		}
	}
	handle {
		respond "Not Found" 404
	}
}
