{
  "name": "geraiexpress",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check:environments": "node scripts/check-environments.mjs",
    "docker:build": "bash scripts/docker.sh build",
    "docker:up": "bash scripts/docker.sh up",
    "docker:down": "bash scripts/docker.sh down",
    "smoke:container": "bash scripts/container-smoke.sh",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:areas": "node scripts/load-mengantar-areas.mjs",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore-check": "bash scripts/db-restore-check.sh",
    "db:reset": "bash scripts/db-migrate.sh --reset",
    "db:verify": "bash scripts/db-verify.sh",
    "db:fixture": "bash scripts/db-fixture.sh",
    "test:db": "vitest run tests/db",
    "dev:env": "bash scripts/dev-env.sh",
    "smoke:preview": "playwright test -c playwright.preview.config.ts",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/postgrest-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "input-otp": "^1.5.0",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "qrcode-generator": "2.0.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
