{
  "name": "geraiexpress",
  "services": {
    "app": {
      "image": "geraiexpress:2026-10-29",
      "environment": { "POSTGREST_URL": "http://postgrest:3000", "TRUSTED_PROXY": "1", "CRON_SECRET": "fixture-cron-secret-0123456789abcdef" },
      "expose": ["3000"],
      "read_only": true,
      "logging": { "driver": "local", "options": { "max-size": "10m", "max-file": "3" } }
    },
    "scheduler": {
      "image": "geraiexpress:2026-10-29",
      "command": ["node", "scheduler.mjs"],
      "environment": { "CRON_SECRET": "fixture-cron-secret-0123456789abcdef", "SCHEDULER_TARGET": "http://app:3000" },
      "read_only": true,
      "logging": { "driver": "local", "options": { "max-size": "10m", "max-file": "3" } }
    },
    "postgrest": {
      "image": "postgrest/postgrest:v14.18@sha256:c7cd7e265a85b05248abf53f4473fcec7e327c282d0bd0cf60f1551996d09fcf",
      "environment": {
        "PGRST_DB_URI": "postgres://authenticator:fixture@db.internal:5432/geraiexpress", "PGRST_JWT_SECRET": "fixture-jwt-secret-0123456789abcdef0123",
        "PGRST_DB_SCHEMAS": "public", "PGRST_DB_ANON_ROLE": "anon", "PGRST_JWT_AUD": "authenticated", "PGRST_DB_MAX_ROWS": "1000"
      },
      "expose": ["3000"],
      "read_only": true,
      "logging": { "driver": "local", "options": { "max-size": "10m", "max-file": "3" } }
    },
    "proxy": {
      "image": "caddy:2.11.2-alpine@sha256:834468128c7696cec0ceea6172f7d692daf645ae51983ca76e39da54a97c570d",
      "environment": { "SITE_HOST": "geraiexpress.com" },
      "read_only": true,
      "cap_drop": ["ALL"],
      "cap_add": ["NET_BIND_SERVICE"],
      "logging": { "driver": "local", "options": { "max-size": "10m", "max-file": "3" } },
      "volumes": [{ "type": "bind", "source": "./infra/proxy/Caddyfile", "target": "/etc/caddy/Caddyfile", "read_only": true }],
      "ports": [
        { "host_ip": "0.0.0.0", "target": 80, "published": "80", "protocol": "tcp" },
        { "host_ip": "0.0.0.0", "target": 443, "published": "443", "protocol": "tcp" },
        { "host_ip": "0.0.0.0", "target": 443, "published": "443", "protocol": "udp" }
      ]
    }
  }
}
