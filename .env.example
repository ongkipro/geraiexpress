# T-062 / DEC-020 / ADR-0002: variable NAMES for the container environment. Public or non-secret values only; every
# secret is listed WITHOUT a value. The app reads these from process.env at run time through ONE reader
# (src/lib/config.ts); nothing here is NEXT_PUBLIC_*, so none of it is inlined into the browser bundle.
#
# - Local development: `pnpm dev:env` (run by `pnpm db:up`) writes .env.local (next dev) and .env.container (the
#   local container, `pnpm docker:up`) plus infra/dev/*.env (the local database stack); all gitignored and
#   holding local values only.
# - Staging and production: infra/env/staging.env.example and infra/env/production.env.example are the
#   templates; the real file is mode 0600 and lives OUTSIDE the repository (RELEASE.md).
# GX_ENV_FILE is REQUIRED when running production Compose. Its CRON_SECRET must be present and every
# configured secret at least 32 characters, not a placeholder (`pnpm check:environments`). Empty values
# here are placeholders only. IPv4-only proxy ports require A records only, no AAAA (RELEASE.md).

# Data API (ADR-0002): the PostgREST the app talks to. Production Compose defaults to http://postgrest:3000.
POSTGREST_URL=
# Auth (application-owned): AUTH_JWT_SECRET signs the access tokens PostgREST verifies (and the machine identity,
# DEC-010); AUTH_SECRET roots the one-time-code and TOTP-sealing keys. Secrets, at least 32 characters, different.
AUTH_JWT_SECRET=
AUTH_SECRET=
# Cloudflare Turnstile: the site key is public, the secret verifies tokens server-side and is REQUIRED unless
# AUTH_CAPTCHA_DISABLED=true (local stacks without a widget only; never staging or production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_CAPTCHA_DISABLED=

# Credential sealing (SEC-7). Secrets. CREDENTIAL_KEY is the legacy single key (version 1); the ring
# (CREDENTIAL_KEYS JSON + CREDENTIAL_KEY_CURRENT) supersedes it at first rotation.
CREDENTIAL_KEY=
CREDENTIAL_KEYS=
CREDENTIAL_KEY_CURRENT=

# Mengantar (sandbox or production; an environment's own value)
MENGANTAR_ENV=sandbox
PARTNER_ID=
# Secret: Mengantar Partner Secret (never stored in the database).
MENGANTAR_PARTNER_SECRET=
PARTNER_TERMS_VERSION=
PARTNER_PRIVACY_VERSION=
PARTNER_TERMS_URL=
PARTNER_PRIVACY_URL=

# Hosts (DEC-015). The four absolute origins the app builds links from; APP_ORIGIN must also be a BUILD
# argument of the image (docker build --build-arg APP_ORIGIN=...). Unset locally: links stay relative.
SITE_ORIGIN=
APP_ORIGIN=
OWNER_ORIGIN=
HOOKS_ORIGIN=
# 1 = a production build on a loopback host serves every audience (the local container only; never in
# staging or production).
HOST_SHARED_MODE=

# Reverse proxy trust (T-062). 1 = read the client address from X-Real-IP, which the proxy overwrites. compose.yaml
# sets it for the app; set it yourself only where a proxy really overwrites X-Real-IP (not on an exposed port).
TRUSTED_PROXY=

# Mail transport for the emailed sign-in code (T-063, owner-gated: production stays unconfigured and fails
# closed; mailpit is local only).
MAIL_TRANSPORT=
MAILPIT_URL=
MAIL_FROM=

# Scheduler: bearer secret for /api/internal/cron/* (route disabled while unset). Secret.
CRON_SECRET=

# Compose only, not read by the app: the database side of the production shape (compose.yaml). PGRST_DB_URI is the
# `authenticator` connection string PostgREST uses; POSTGRES_PASSWORD only for the optional `postgres` service
# (profile `db`). Secrets.
PGRST_DB_URI=
POSTGRES_PASSWORD=

# PostgreSQL target for scripts/db-migrate.sh instead of the local Compose container (psql on PATH).
# --reset still refuses any host but loopback and any database whose name does not start with gx.
DATABASE_URL=
