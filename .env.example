# Server-only configuration. Local values come from `pnpm dev:env` (local Supabase stack).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# T-015: AES-256-GCM key for sealing seller API keys (base64 of 32 random bytes). Worker secret in
# production (`wrangler secret put CREDENTIAL_KEY`); `pnpm dev:env` generates a local one.
CREDENTIAL_KEY=
# Mengantar Partner Secret (Worker secret only; never stored in the database).
MENGANTAR_PARTNER_SECRET=
