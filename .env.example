# Public and non-secret variables only. No secret NAME or value is listed here: every secret, credential and
# connection string lives in the protected env files described in RELEASE.md. Templates with the complete
# variable list (names, placeholders, no values): infra/env/staging.env.example and infra/env/production.env.example.
#
# The app reads these from process.env at run time through ONE reader (src/lib/config.ts); nothing here is
# NEXT_PUBLIC_*, so none of it is inlined into the browser bundle.
# - Local development: `pnpm dev:env` (run by `pnpm db:up`) writes .env.local (next dev) and .env.container (the
#   local container, `pnpm docker:up`) plus infra/dev/*.env (the local database stack); all gitignored and
#   holding local values only.
# - Staging and production: the real file is mode 0600 and lives OUTSIDE the repository (RELEASE.md).
# Empty values here are placeholders only. IPv4-only proxy ports require A records only, no AAAA (RELEASE.md).

# Data API (ADR-0002): the PostgREST the app talks to. Production Compose defaults to http://postgrest:3000.
POSTGREST_URL=
# Cloudflare Turnstile site key (public). AUTH_CAPTCHA_DISABLED=true is for local stacks without a widget only;
# never staging or production.
TURNSTILE_SITE_KEY=
# Public hosts serving the widget (comma-separated), required with TURNSTILE_SECRET_KEY; never localhost.
TURNSTILE_HOSTNAMES=
AUTH_CAPTCHA_DISABLED=

# Mengantar (sandbox or production; an environment's own value) and the Partner legal-document versions.
MENGANTAR_ENV=sandbox
PARTNER_ID=
PARTNER_TERMS_VERSION=
PARTNER_PRIVACY_VERSION=
PARTNER_TERMS_URL=
PARTNER_PRIVACY_URL=

# Hosts (DEC-015). The four absolute origins the app builds links from; APP_ORIGIN must also be a BUILD
# argument of the image (docker build --build-arg APP_ORIGIN=...). Unset locally: links stay relative.
SITE_ORIGIN=
APP_ORIGIN=
OWNER_ORIGIN=
HOOKS_ORIGIN=
# 1 = a production build on a loopback host serves every audience (the local container only; never in
# staging or production).
HOST_SHARED_MODE=

# Reverse proxy trust (T-062). 1 = read the client address from X-Real-IP, which the proxy overwrites. compose.yaml
# sets it for the app; set it yourself only where a proxy really overwrites X-Real-IP (not on an exposed port).
TRUSTED_PROXY=

# Mail transport for the emailed sign-in code (T-063): unset = fails closed; mailpit = local only; smtp = the
# provider's SMTP submission (TLS mandatory). MAIL_FROM defaults to no-reply@geraiexpress.com.
MAIL_TRANSPORT=
MAILPIT_URL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
