{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geraiexpress",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "geraiexpress" }],
  // RATE-1: per-visitor (CF-Connecting-IP) limits checked before Supabase Auth; see src/lib/rate-limit.ts.
  "ratelimits": [
    { "name": "SIGN_IN_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "DEMO_LIMITER", "namespace_id": "3002", "simple": { "limit": 5, "period": 60 } },
    { "name": "MFA_LIMITER", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
    { "name": "OTP_LIMITER", "namespace_id": "3004", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
