{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geraiexpress",
  // Custom entry: the OpenNext handler plus the dispatcher sweep cron (T-024).
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "geraiexpress" }],
  // RATE-1: per-visitor (CF-Connecting-IP) limits checked before Supabase Auth; see src/lib/rate-limit.ts.
  "ratelimits": [
    { "name": "SIGN_IN_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "DEMO_LIMITER", "namespace_id": "3002", "simple": { "limit": 5, "period": 60 } },
    { "name": "MFA_LIMITER", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
    { "name": "OTP_LIMITER", "namespace_id": "3004", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // TD-3 dispatcher sweep every 5 minutes; a no-op without the machine bindings.
  "triggers": { "crons": ["*/5 * * * *"] },
  // DEL-1 stage 2 preview (T-018): isolated synthetic-data demo on workers.dev against the
  // `geraiexpress-preview` Supabase project. Bindings are not inherited, so they are repeated;
  // rate-limit namespaces differ so preview never shares counters with another environment.
  // Secrets (CREDENTIAL_KEY, SEND_EMAIL_HOOK_SECRET) are set with `wrangler secret put --env preview`.
  // MAIL_TRANSPORT is deliberately unset: Auth email fails closed until Cloudflare Email Sending
  // is verified (DEC-009). TURNSTILE_SITE_KEY is Cloudflare's test key until a real widget exists
  // (Auth captcha is off on the preview; see ARCHITECTURE.md).
  "env": {
    "preview": {
      "name": "geraiexpress-preview",
      // The preview has no machine identity or Mengantar environment: no sweep.
      "triggers": { "crons": [] },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "geraiexpress-preview" }],
      "ratelimits": [
        { "name": "SIGN_IN_LIMITER", "namespace_id": "4001", "simple": { "limit": 10, "period": 60 } },
        { "name": "DEMO_LIMITER", "namespace_id": "4002", "simple": { "limit": 5, "period": 60 } },
        { "name": "MFA_LIMITER", "namespace_id": "4003", "simple": { "limit": 10, "period": 60 } },
        { "name": "OTP_LIMITER", "namespace_id": "4004", "simple": { "limit": 3, "period": 60 } }
      ],
      "vars": {
        "SUPABASE_URL": "https://jezxplwwmjogrmlixdcw.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_CjBGzsKrrJPuKThPU1n2DQ_pCKaZNp1",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "MAIL_FROM": "no-reply@geraiexpress.local"
      },
      "observability": { "enabled": true }
    }
  }
}
